}

// ─── Monthly Goal ─────────────────────────────────────────────────────────────

model MonthlyGoal {
  id             String   @id @default(cuid())
  userId         String
  year           Int
  month          Int
  targetR        Float?
  targetWinRate  Float?
  targetTrades   Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("monthly_goals")
}

// ─── Funded Account ────────────────────────────────────────────────────────────

model FundedAccount {
  id              String        @id @default(cuid())
  userId          String
  firmName        String
  phase           Int           @default(1)
  accountId       String?
  startingBalance Float
  currentEquity   Float
  profitTarget       Float
  phase2StartBalance Float?
  maxDailyLoss       Float
  maxTotalLoss    Float
  status          AccountStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  equityLogs EquityLog[]

  @@index([userId])
  @@map("funded_accounts")
}

model EquityLog {
  id        String        @id @default(cuid())
  accountId String
  date      DateTime      @default(now())
  equity    Float
  pnlToday  Float?
  note      String?

  account FundedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@map("equity_logs")
}

enum AccountStatus {
  ACTIVE
  PASSED
  FAILED
  REVIEW
}

// ─── Mentorship ────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STUDENT
}

enum MenteeStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum ResourceType {
  VIDEO
  DOCUMENT
  LINK
  IMAGE
}

model MenteeProfile {
  id         String       @id @default(cuid())
  userId     String       @unique
  status     MenteeStatus @default(PENDING)
  approvedAt DateTime?
  adminNotes String?
  createdAt  DateTime     @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@map("mentee_profiles")
}

model MentorNote {
  id        String   @id @default(cuid())
  menteeId  String
  content   String
  createdAt DateTime @default(now())

  mentee User @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([menteeId])
  @@map("mentor_notes")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters Chapter[]

  @@map("courses")
}

model Chapter {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("chapters")
}

model Lesson {
  id          String   @id @default(cuid())
  chapterId   String
  title       String
  content     String?
  videoUrl    String?
  documentUrl String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter  Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@map("lessons")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  profile MenteeProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  lesson  Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        ResourceType
  url         String
  category    String?
  lessonId    String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([lessonId])
  @@map("resources")
}

model NotionPage {
  id        String   @id @default(cuid())
  title     String
  url       String
  category  String?
  emoji     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("notion_pages")
}

// ─── Weekly Review ────────────────────────────────────────────────────────────

model WeeklyReview {
  id            String   @id @default(cuid())
  userId        String
  weekStart     DateTime @db.Date
  wentWell      String?
  toImprove     String?
  nextFocus     String?
  commitment    String?
  overallRating Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("weekly_reviews")
}

// ─── Playbook ─────────────────────────────────────────────────────────────────

model PlaybookEntry {
  id           String   @id @default(cuid())
  userId       String
  title        String
  category     String
  description  String?
  conditions   String[]
  management   String[]
  invalidation String[]
  notes        String?
  imageUrls    String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("playbook_entries")
}

// ─── Trade Log (broker CSV import) ────────────────────────────────────────────

model BrokerTrade {
  id          String   @id @default(cuid())
  userId      String
  source      String
  account     String?
  instrument  String
  direction   String
  quantity    Int
  entryPrice  Float
  exitPrice   Float
  entryTime   DateTime
  exitTime    DateTime
  durationSec Int?
  grossPnl    Float?
  commission  Float?
  fees        Float?
  netPnl      Float?
  riskUsd     Float?
  journalNote String?
  chartUrl    String?
  externalRef String
  rawRow      Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalRef])
  @@index([userId, entryTime])
  @@map("broker_trades")
}

// ─── Market Research (Odin Discord archive) ───────────────────────────────────

enum MarketAnalysisType {
  PRE_MARKET
  INTRADAY
  EOD
  EOW
}

enum MarketInstrument {
  NQ
  ES
  YM
}

model MarketWeek {
  id        String   @id @default(cuid())
  weekStart DateTime @unique
  weekEnd   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days MarketDay[]

  @@index([weekStart, weekEnd])
  @@map("market_weeks")
}

model MarketDay {
  id           String    @id @default(cuid())
  date         DateTime  @unique
  marketWeekId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  marketWeek MarketWeek?     @relation(fields: [marketWeekId], references: [id], onDelete: SetNull)
  messages   MarketMessage[]

  @@index([marketWeekId])
  @@map("market_days")
}

model MarketMessage {
  id              String             @id @default(cuid())
  marketDayId     String
  sourceChannel   String
  analysisType    MarketAnalysisType
  author          String
  timestamp       DateTime
  content         String
  sourceMessageId String?            @unique
  sourceFile      String
  contentHash     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  marketDay   MarketDay             @relation(fields: [marketDayId], references: [id], onDelete: Cascade)
  attachments MarketAttachment[]
  instruments InstrumentReference[]

  @@index([marketDayId, analysisType])
  @@index([timestamp])
  @@index([sourceChannel])
  @@index([contentHash])
  @@map("market_messages")
}

model MarketAttachment {
  id                  String   @id @default(cuid())
  messageId           String
  storageKey          String
  thumbnailStorageKey String?
  originalFilename    String
  mimeType            String
  fileSize            Int
  width               Int?
  height              Int?
  checksum            String
  createdAt           DateTime @default(now())

  message MarketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([checksum])
  @@map("market_attachments")
}

model InstrumentReference {
  id         String           @id @default(cuid())
  messageId  String
  instrument MarketInstrument
  createdAt  DateTime         @default(now())

  message MarketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, instrument])
  @@index([instrument])
  @@map("instrument_references")
}

model MarketImportRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    @default("running")
  filesTotal  Int       @default(0)
  filesDone   Int       @default(0)
  imported    Int       @default(0)
  duplicates  Int       @default(0)
  errors      Int       @default(0)
  errorDetail Json?
  triggeredBy String?

  @@map("market_import_runs")
}
