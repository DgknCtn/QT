}

enum Po3State {
  ACCUMULATION
  MANIPULATION
  DISTRIBUTION
  X
  UNKNOWN
}

enum MmxmStage {
  ACCUMULATION
  MANIPULATION
  DISTRIBUTION
  REVERSAL
  CONTINUATION
  UNKNOWN
}

enum WeeklyCycle {
  MONDAY_Q1
  TUESDAY_Q2
  WEDNESDAY_Q3
  THURSDAY_Q4
  FRIDAY_SPECIAL
}

