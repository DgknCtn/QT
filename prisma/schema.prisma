  TDO
  TSO
  TMSO
  PREV_HIGH
  PREV_LOW
  DFR_HIGH
  DFR_LOW
  DFR_MID
  DFR_PROJECTION
  FVG
  OB
  NWOG
  NDOG
  EQUAL_HIGHS
  EQUAL_LOWS
  CUSTOM_POI
  CUSTOM_TOI
