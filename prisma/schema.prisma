generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Models ────────────────────────────────────────────────────────────────

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  role                UserRole @default(STUDENT)
  timezone            String   @default("America/New_York")
  preferredSessions   String[] @default(["NY_AM"])
  maxRiskPerTrade     Float    @default(1.0)
  maxDailyRisk        Float    @default(3.0)
  defaultMarkets      String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dailyPreps     DailyPrep[]
  levels         Level[]
  dfrs           DFR[]
  ssmtEvents     SSMTEvent[]
  confirmations  Confirmation[]
  trades         Trade[]
  tags           Tag[]
  screenshots    Screenshot[]
  economicEvents EconomicEvent[]
  fundedAccounts FundedAccount[]
  monthlyGoals   MonthlyGoal[]
  menteeProfile    MenteeProfile?
  playbookEntries  PlaybookEntry[]
  weeklyReviews    WeeklyReview[]
  mentorNotes      MentorNote[]
  brokerTrades     BrokerTrade[]
  conceptProgress  ConceptProgress[]

  @@map("users")
}

model DailyPrep {
  id                   String            @id @default(cuid())
  userId               String
  date                 DateTime          @db.Date
  session              Session
  marketGroup          MarketGroup
  triad                Triad
  primaryInstrument    String
  secondaryInstruments String[]          @default([])
  htfBias              Bias              @default(WAIT)
  htfBiasConfidence    Confidence        @default(MEDIUM)
  htfTarget            String?
  htfInvalidation      String?
  htfBiasExplanation   String?
  weeklyPo3State       Po3State          @default(UNKNOWN)
  dailyPo3State        Po3State          @default(UNKNOWN)
  mmxmStage            MmxmStage         @default(UNKNOWN)
  activeCycleWeekly    WeeklyCycle?
  activeCycleDaily     DailyCycle?
  active90mCycle       QuarterCycle?
  activeMicroCycle     QuarterCycle?
  q1Quality            Q1Quality?
  expectedBehavior     ExpectedBehavior?
  mainLiquidityTarget  LiquidityTarget?
  customLiqTarget      String?
  trueOpenSummary      Json?
  dfrSummary           Json?
  ssmtSummary          Json?
  confirmationSummary  Json?
  newsSummary          Json?
  /// Step 9 giriş planı: entryModel, entryPrice, stopPrice, stopLogic, tp1-3,
  /// mainDol, riskPercent, riskUsd. Diğer *Summary alanları gibi serbest Json.
  entrySummary         Json?
  /// Step 5'te bir kez girilen anlık fiyat. True Open'ların premium/discount
  /// yorumu bundan türetilir (lib/prep/true-open.ts).
  currentPrice         Float?
  goNoGoStatus         GoNoGoStatus?
  goNoGoReason         String?
  completionScore      Float             @default(0)
  qualityScore         Float             @default(0)
  isDraft              Boolean           @default(true)
  fridayHandling       FridayHandling?
  biasRevisedFrom      Bias?
  biasRevisionReason   String?
  biasRevisionTrigger  String?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  levels        Level[]
  dfrs          DFR[]
  ssmtEvents    SSMTEvent[]
  confirmations Confirmation[]
  trades        Trade[]
  screenshots   Screenshot[]

  @@index([userId, date])
  @@map("daily_preps")
}

model Level {
  id            String      @id @default(cuid())
  userId        String
  dailyPrepId   String?
  instrument    String
  marketGroup   MarketGroup
  levelType     LevelType
  price         Float
  timeframe     Timeframe
  dateValidFrom DateTime?
  dateValidTo   DateTime?
  status        LevelStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPrep DailyPrep? @relation(fields: [dailyPrepId], references: [id], onDelete: SetNull)

  @@index([userId, instrument])
  @@index([dailyPrepId])
  @@map("levels")
}

model DFR {
  id                 String           @id @default(cuid())
  userId             String
  dailyPrepId        String?
  dfrType            DFRType
  timeframeAlignment Timeframe?
  q1StartTime        DateTime?
  q1EndTime          DateTime?
  t2High             Float?
  t2Low              Float?
  t3High             Float?
  t3Low              Float?
  dfrHigh            Float?
  dfrLow             Float?
  dfrMid             Float?
  projection1        Float?
  projection2        Float?
  projectionNeg1     Float?
  projectionNeg2     Float?
  q1Quality          DFRq1Quality?
  highLowEqualsQ1    ThreeState?
  dfrQualityScore    Int              @default(0)
  dfrQualityBand     QualityBand?
  alignsWithBias     Boolean?
  nearPriorPoi       Boolean?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPrep DailyPrep? @relation(fields: [dailyPrepId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dailyPrepId])
  @@map("dfrs")
}

model SSMTEvent {
  id                String        @id @default(cuid())
  userId            String
  dailyPrepId       String?
  marketGroup       MarketGroup
  triad             Triad
  primaryInstrument String
  ssmtType          SSMTType
  locationType      SSMTLocation
  locationPrice     Float?
  timeframe         Timeframe
  assetABehavior    String?
  assetBBehavior    String?
  assetCBehavior    String?
  strongAsset       String?
  weakAsset         String?
  alignsWithBias    ThreeState?
  randomSmtFlag     Boolean       @default(false)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPrep     DailyPrep?     @relation(fields: [dailyPrepId], references: [id], onDelete: SetNull)
  confirmations Confirmation[]

  @@index([userId])
  @@index([dailyPrepId])
  @@map("ssmt_events")
}

model Confirmation {
  id               String           @id @default(cuid())
  userId           String
  dailyPrepId      String?
  ssmtEventId      String?
  confirmationType ConfirmationType
  timeframe        Timeframe
  tfAlignmentValid ThreeState?
  entryRelevance   String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPrep DailyPrep? @relation(fields: [dailyPrepId], references: [id], onDelete: SetNull)
  ssmtEvent SSMTEvent? @relation(fields: [ssmtEventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dailyPrepId])
  @@index([ssmtEventId])
  @@map("confirmations")
}

model Trade {
  id              String           @id @default(cuid())
  userId          String
  dailyPrepId     String?
  date            DateTime         @db.Date
  instrument      String
  marketGroup     MarketGroup
  triad           Triad
  session         Session
  direction       Direction
  setupType       SetupType
  entryModel      EntryModel
  entryPrice      Float?
  stopPrice       Float?
  stopLogic       StopLogic?
  tp1             Float?
  tp2             Float?
  tp3             Float?
  mainDol         Float?
  riskPercent     Float?
  rResult         Float?
  pnlPoints       Float?
  pnlCurrency     Float?
  result          TradeResult
  processScore    Float?
  processGrade    ProcessGrade?
  planFollowed    PlanFollowed?
  goStatusAtEntry GoStatusAtEntry?
  nearNews        Boolean          @default(false)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPrep   DailyPrep?   @relation(fields: [dailyPrepId], references: [id], onDelete: SetNull)
  tags        TradeTag[]
  screenshots Screenshot[]

  @@index([userId, date])
  @@index([userId, instrument])
  @@index([dailyPrepId])
  @@map("trades")
}

model Tag {
  id        String      @id @default(cuid())
  userId    String
  name      String
  category  TagCategory
  createdAt DateTime    @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades TradeTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TradeTag {
  tradeId String
  tagId   String

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@map("trade_tags")
}

model Screenshot {
  id             String         @id @default(cuid())
  userId         String
  tradeId        String?
  dailyPrepId    String?
  conceptId      String?
  fileUrl        String
  screenshotType ScreenshotType
  notes          String?
  createdAt      DateTime       @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade     Trade?     @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  dailyPrep DailyPrep? @relation(fields: [dailyPrepId], references: [id], onDelete: SetNull)
  concept   Concept?   @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tradeId])
  @@index([dailyPrepId])
  @@map("screenshots")
}

model Concept {
  id                 String          @id @default(cuid())
  title              String
  category           ConceptCategory
  definition         String?
  whyItMatters       String?
  whenToUse          String?
  whenNotToUse       String?
  requiredConditions String?
  commonMistakes     String?
  checklistQuestions String[]        @default([])
  isSystemConcept    Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  screenshots Screenshot[]
  progress    ConceptProgress[]

  @@map("concepts")
}

/// Per-user learning state for a shared `Concept`.
/// `confidenceLevel`/`userNotes` used to live on the Concept row itself, which
/// meant one user's rating and notes overwrote everyone else's.
model ConceptProgress {
  id              String          @id @default(cuid())
  userId          String
  conceptId       String
  confidenceLevel ConfidenceLevel @default(NEW)
  userNotes       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([conceptId])
  @@map("concept_progress")
}

/// `userId == null` is a GLOBAL event: seeded from the economic calendar and
/// visible to every account. A non-null `userId` is a private event the user
/// added themselves. Always read through `economicEventScope()` in
/// `lib/economic-events.ts` so both kinds show up.
model EconomicEvent {
  id                   String        @id @default(cuid())
  userId               String?
  dateTime             DateTime
  currency             String
  eventName            String
  impact               EventImpact
  source               EventSource   @default(MANUAL)
  userRiskTag          EventRiskTag?
  noTradeBeforeMinutes Int?
  noTradeAfterMinutes  Int?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateTime])
  @@index([dateTime])
  @@map("economic_events")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

